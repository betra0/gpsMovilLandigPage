---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarruselMain from '../components/CarruselMain.astro';

const slideClass=`group rounded-xl bg-slate-950 border border-white/5 flex flex-col justify-center items-center pb-4 px-4 
				transition-transform duration-300 hover:-translate-y-3 hover:border-cyan-500/30`
---

<BaseLayout title="GPS Móvil - Monitoreo GPS" >

	<CarruselMain />


  <section class="relative flex mt-10 max-w-[1300px] mx-auto bg-slate-950 rounded-2xl ">
		<img
		  src="/images/vehiculo-movimiento.avif"
		  class="w-1/2 aspect-[16/16] object-cover max-[650px]:w-full max-[650px]:h-145"
		/>
		<div class="flex-1 flex flex-col pl-2 items-center
			max-[650px]:absolute	
			max-[650px]:inset-0
			max-[650px]:z-5
			max-[650px]:bg-slate-950/80
		">
			<div class="max-w-[450px] flex-1 flex flex-col justify-center gap-6">
			  <h3 class="text-2xl font-bold text-center">
			    Beneficios económicos reales para tu flota
			  </h3>
		  
			  <p class="text-sm text-slate-300 text-center">
			    Control total de tus vehículos en tiempo real para reducir costos,
			    mejorar la seguridad y optimizar cada operación.
			  </p>
		  
			  <ul class="flex flex-col gap-4 text-sm">
			    <li>
			      <strong>Control y trazabilidad completa</strong><br />
			      Ubicación, rutas, carga y registros históricos en todo momento.
			    </li>
			
			    <li>
			      <strong>Reducción de costos operativos</strong><br />
			      Menos combustible, menos mantención y menos tiempos improductivos.
			    </li>
			
			    <li>
			      <strong>Seguridad y cumplimiento</strong><br />
			      Prevención de robos, control de velocidad y certificación para faenas.
			    </li>
			
			    <li>
			      <strong>Mejor servicio y respuesta</strong><br />
			      Entregas puntuales y asistencia rápida ante emergencias.
			    </li>
			  </ul>
		  
			  <a
			    href="/contacto"
			    class="bg-slate-800 text-cyan-400 p-3 rounded-lg text-center mx-auto border border-cyan-500/10 max-w-[200px]
			           hover:bg-cyan-500/10 hover:border-cyan-500/50 transition active:scale-95"
			  >
			    Solicitar cotización
			  </a>
			</div>


		</div>
	</section>
  
	<section id="soluciones" class="max-w-[1300px] mx-auto mt-14 px-6 mb-24"
	  >
		<h2 class="text-4xl font-bold text-center mb-12">
			Soluciones de monitoreo GPS
		</h2>


	  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 min-h-[400px]">

			<a
  			href="https://ms03.trackingmate.com/?AspxAutoDetectCookieSupport=1"
  			class="md:col-span-3 group relative rounded-2xl overflow-hidden
         bg-slate-950 border border-white/5
         hover:border-cyan-500/40 transition"
				 >
			  	<img
			  	  src="/images/plataforma5.png"
			  	  class="absolute top-0 right-0 bottom-0 h-full object-contain opacity-80
			  	         group-hover:scale-105 transition duration-500"
			  	/>

			  	<div class="relative p-10 max-w-2xl text-shadow-lg/90 text-shadow-slate-950">
			  	  <span class="text-cyan-400 uppercase text-sm">
			  	    Plataforma de monitoreo
			  	  </span>
					
			  	  <h3 class="text-3xl font-bold mt-2 text-shadow-lg/60 text-shadow-slate-950">
			  	    MS3 – Control total de tu flota
			  	  </h3>
					
			  	  <p class="mt-4 text-slate-300 text-shadow-lg/90 text-shadow-slate-950">
			  	    Ubicación en tiempo real, reportes históricos, alertas y gestión
			  	    desde PC o smartphone.
			  	  </p>
					
			  	  <span class="inline-block mt-6 text-cyan-400 font-semibold text-shadow-lg/90 text-shadow-slate-950">
			  	    Ver plataforma →
			  	  </span>
			  	</div>
			</a>

			<div class={`${slideClass}`}>
  				<img src="/images/tr66-1.avif" class="rounded-lg mb-4 w-full pt-4" />
  				<h4 class="text-xl font-semibold">Rastreador T366</h4>
  				<p class="text-slate-400 mt-2 text-sm">
    				Dispositivo GPS de última generación, resistente al polvo y al agua, que envía la ubicación del vehículo en tiempo real a los servidores.
  				</p>
			</div>

			<div class={`${slideClass}`}>
  				<img src="/images/intalacion1.avif" class="rounded-lg mb-4 w-full pt-4" />
  				<h4 class="text-xl font-semibold">Instalación y Configuración</h4>
  				<p class="text-slate-400 mt-2 text-sm">
    				Instalación profesional y segura de los dispositivos T366 en tus vehículos.
  				</p>
			</div>

			<div class={`${slideClass}`}>
  				<img src="/images/antirobo1.avif" class="rounded-lg mb-4 w-full pt-4" />
  				<h4 class="text-xl font-semibold">Sistema Antirrobo</h4>
  				<p class="text-slate-400 mt-2 text-sm">
    				Sistema antirrobo opcional que permite detener el vehículo en caso de robo desde tu celular.
  				</p>
			</div>



		</div>

	</section>  
</BaseLayout>

