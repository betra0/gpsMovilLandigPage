---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarruselMain from '../components/CarruselMain.astro';
---

<BaseLayout title="GPS Móvil - Monitoreo GPS" >

	<CarruselMain />


  <section class="relative flex mt-6 max-w-[1400px] mx-auto bg-slate-950 rounded-2xl ">
		<img
		  src="/images/vehiculo-movimiento.avif"
		  class="w-1/2 aspect-[14/16] object-cover max-[650px]:w-full max-[650px]:h-200"
		/>
		<div class="flex-1 flex flex-col pl-2 items-center
			max-[650px]:absolute	
			max-[650px]:inset-0
			max-[650px]:z-5
    max-[650px]:bg-slate-950/80
		">
			<div class="max-w-[450px] flex-1 flex justify-around flex-col">
				<h3 class="text-2xl font-bold p-0 m-0 text-center">Beneficios económicos que han reportado nuestros clientes</h3>

				<p>- Conocimiento de la ubicación de cada vehículo en cada momento</p>
				<p>- Conocer el estado y la ubicación de la carga en todo momento</p>
				<p>- Disminución de los tiempos improductivos</p>
				<p>- Puntualidad en las entregas y retiros</p>
				<p>- Disminución del uso inapropiado de los vehículos</p>
				<p>- Conocer la trazabilidad de la ruta origen-destino</p>
				<p>- Enviar el vehículo más cercano a un cierto trabajo</p>
				<p>- Disminución de gastos de combustible y mantención</p>
				<p>- Certificación para trabajos en faenas mineras</p>
				<p>- Recuperación de vehículos ante robo</p>
				<p>- Disminución de excesos de velocidad y accidentabilidad</p>
				<p>- Asistencia rápida al vehículo en caso de emergencia</p>
				<p>- Investigación y gestión mediante el uso de los registros históricos</p>
				<a href="/contacto" 
				class="bg-slate-800 text-cyan-400 p-3 rounded-lg text-center mx-auto border border-cyan-500/10 max-w-[200px]
				hover:bg-cyan-500/10 hover:border-cyan-500/50 transition duration-400 block
				active:bg-cyan-500/1 active:scale-95
				">
					Solicitar cotización</a>
			</div>


		</div>
	</section>
  
	<section id="soluciones" class="max-w-[1300px] mx-auto mt-24 px-6 mb-24"
	  >
		<h2 class="text-4xl font-bold text-center mb-12">
			Soluciones de monitoreo GPS
		</h2>


	  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 min-h-[400px]">

			<a
  			href="https://app.misistemas3.cl/login"
  			class="md:col-span-3 group relative rounded-2xl overflow-hidden
         bg-slate-950 border border-white/5
         hover:border-cyan-500/40 transition"
				 >
			  	<img
			  	  src="/images/plataforma5.png"
			  	  class="absolute top-0 right-0 bottom-0 h-full object-contain opacity-70
			  	         group-hover:scale-105 transition duration-500"
			  	/>

			  	<div class="relative p-10 max-w-2xl">
			  	  <span class="text-cyan-400 uppercase text-sm">
			  	    Plataforma de monitoreo
			  	  </span>
					
			  	  <h3 class="text-3xl font-bold mt-2">
			  	    MS3 – Control total de tu flota
			  	  </h3>
					
			  	  <p class="mt-4 text-slate-300">
			  	    Ubicación en tiempo real, reportes históricos, alertas y gestión
			  	    desde PC o smartphone.
			  	  </p>
					
			  	  <span class="inline-block mt-6 text-cyan-400 font-semibold">
			  	    Ver plataforma →
			  	  </span>
			  	</div>
			</a>

			<div class="group rounded-xl bg-slate-950 border border-white/5 flex flex-col justify-center items-center
            hover:border-cyan-500/30 transition">
  			<img src="/images/tr66-1.avif" class="rounded-lg mb-4 w-full px-4 pt-4" />
  			<h4 class="text-xl font-semibold">Rastreador T366</h4>
  			<p class="text-slate-400 mt-2 text-sm">
    			Dispositivo GPS resistente al polvo y agua.
  			</p>
			</div>

			<div class="group rounded-xl  bg-slate-950 border border-white/5 flex flex-col justify-center items-center
            hover:border-cyan-500/30 transition">
  			<img src="/images/intalacion1.avif" class="rounded-lg mb-4 w-full px-4 pt-4" />
  			<h4 class="text-xl font-semibold">Instalación y Configuración</h4>
  			<p class="text-slate-400 mt-2 text-sm">
    			Dispositivo GPS resistente al polvo y agua.
  			</p>
			</div>

			<div class="group rounded-xl  bg-slate-950 border border-white/5 flex flex-col justify-center items-center
            hover:border-cyan-500/30 transition">
  			<img src="/images/antirobo1.avif" class="rounded-lg mb-4 w-full px-4 pt-4" />
  			<h4 class="text-xl font-semibold">Sistema Antirrobo</h4>
  			<p class="text-slate-400 mt-2 text-sm">
    			Dispositivo GPS resistente al polvo y agua.
  			</p>
			</div>



		</div>

	</section>  
</BaseLayout>

